// Prisma schema for TrekVibe Nepal's content + inquiry backend.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  blurb     String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  blurb     String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trek {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  region          String
  regionSlug      String
  regionLabel     String
  categorySlug    String   @default("trekking")
  categoryLabel   String   @default("Trekking")
  tagline         String
  heroImage       String
  gallery         Json     @default("[]")
  duration        String
  durationDays    Int
  maxAltitude     String
  difficulty      String
  bestSeason      String
  groupSize       String
  priceFrom       Int
  restrictedArea  Boolean  @default(false)
  shortDescription String  @db.Text
  overview        String   @db.Text
  highlights      Json     @default("[]")
  permits         Json     @default("[]")
  itinerary       Json     @default("[]")
  included        Json     @default("[]")
  excluded        Json     @default("[]")
  faqs            Json     @default("[]")
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([regionSlug])
  @@index([categorySlug])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  coverImage  String
  category    String
  author      String
  date        DateTime
  readTime    String
  keywords    Json     @default("[]")
  content     Json     @default("[]")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  trek      String
  rating    Int      @default(5)
  quote     String   @db.Text
  // Set only on reviews guests submit from /reviews; never shown publicly.
  email     String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  title     String
  detail    String   @default("")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guide {
  id        String   @id @default(cuid())
  name      String
  role      String
  years     String
  languages String
  bio       String   @db.Text
  photoUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                     String   @id @default("main")
  heroEyebrow            String   @default("Feel the Mountain Vibe — Kathmandu, Nepal")
  heroHeadline           String   @default("Trek the Himalaya with TrekVibe Nepal")
  heroSubheadline        String   @db.Text
  heroImage              String   @default("/images/treks/everest-base-camp.jpg")
  heroPrimaryCtaLabel    String   @default("Explore Treks")
  heroPrimaryCtaHref     String   @default("/treks")
  heroSecondaryCtaLabel  String   @default("Plan a Custom Trek")
  heroSecondaryCtaHref   String   @default("/plan-your-trek")
  heroRatingValue        String   @default("4.9/5")
  heroRatingLabel        String   @default("guest rating")
  heroBadge1             String   @default("Government-licensed guides")
  heroBadge2             String   @default("12+ curated Himalayan routes")
  showWhyChooseUs        Boolean  @default(true)
  showTopTreks           Boolean  @default(true)
  showTestimonials       Boolean  @default(true)
  showGuides             Boolean  @default(true)
  showTripPlannerCta     Boolean  @default(true)
  showBlogPreview        Boolean  @default(true)
  showFaq                Boolean  @default(true)
  showFinalCta           Boolean  @default(true)
  showGallery            Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

// type: "home" | "about" | "treks" | "travellerInfo" | "link"
// The first four are structural (tied to real dropdown content/mega menus)
// and can be relabeled, hidden or reordered but not deleted or retyped.
// "link" items are plain, freely addable/removable menu links.
model NavItem {
  id        String   @id @default(cuid())
  type      String   @default("link")
  label     String
  href      String?
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  variant   String
  name      String
  email     String
  phone     String?
  trek      String?
  dates     String?
  groupSize String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}
