// Prisma schema for TrekVibe Nepal's content + inquiry backend.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  blurb     String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  blurb     String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trek {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  region          String
  regionSlug      String
  regionLabel     String
  categorySlug    String   @default("trekking")
  categoryLabel   String   @default("Trekking")
  tagline         String
  heroImage       String
  gallery         Json     @default("[]")
  duration        String
  durationDays    Int
  maxAltitude     String
  difficulty      String
  bestSeason      String
  groupSize       String
  priceFrom       Int
  restrictedArea  Boolean  @default(false)
  shortDescription String  @db.Text
  overview        String   @db.Text
  highlights      Json     @default("[]")
  permits         Json     @default("[]")
  itinerary       Json     @default("[]")
  included        Json     @default("[]")
  excluded        Json     @default("[]")
  faqs            Json     @default("[]")
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([regionSlug])
  @@index([categorySlug])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  coverImage  String
  category    String
  author      String
  date        DateTime
  readTime    String
  keywords    Json     @default("[]")
  content     Json     @default("[]")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  trek      String
  rating    Int      @default(5)
  quote     String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guide {
  id        String   @id @default(cuid())
  name      String
  role      String
  years     String
  languages String
  bio       String   @db.Text
  photoUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}

model Inquiry {
  id        String        @id @default(cuid())
  variant   String
  name      String
  email     String
  phone     String?
  trek      String?
  dates     String?
  groupSize String?
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}
